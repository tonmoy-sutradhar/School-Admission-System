{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=modular_monolith;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "ModularMonolith",
    "Audience": "ModularMonolith",
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS!",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cache": {
    "UseRedis": false,
    "RedisConnection": "localhost:6379",
    "DefaultExpirationMinutes": 30
  },
  "Cors": {
    "Origins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Admissions": {
    "HoldDurationSeconds": 600
  },
  "EnableHttpsRedirection": false,
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 1000
      },
      {
        "Endpoint": "*:/api/v1/auth/login",
        "Period": "1m",
        "Limit": 20
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}