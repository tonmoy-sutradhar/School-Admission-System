# Copy to .env:  Copy-Item .env.example .env

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
FRONTEND_PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_admission
POSTGRES_PORT=5432

# Seat hold window (seconds). Use a small value (e.g. 10) for local expiry demos.
HOLD_DURATION_SECONDS=600

DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true
CORS_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080

# Still required by the template Identity module (login is not used by the assignment UI)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS!

# Used by the backend container (Docker network hostname = postgres)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=school_admission;Username=postgres;Password=postgres
