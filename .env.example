# Copy to .env and change values for local/Docker use
# cp .env.example .env

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=modular_monolith
POSTGRES_PORT=5432

REDIS_PORT=6379
CACHE_USE_REDIS=true
CACHE_REDIS_CONNECTION=redis:6379

# Must be at least 32 characters
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS!
JWT_ISSUER=ModularMonolith
JWT_AUDIENCE=ModularMonolith

DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true
CORS_ORIGIN=http://localhost:3000

# Used by the API container (Docker network hostname = postgres)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=modular_monolith;Username=postgres;Password=postgres
